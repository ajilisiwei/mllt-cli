# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Debug binaries
__debug_bin*

# Temporary files
*.tmp
*.temp

# Log files
*.log

# Binary files. 前导斜杠限定只匹配仓库根目录，
# 否则 "mllt-cli" 会把 cmd/mllt-cli/ 这个源码目录一并忽略掉。
/lang-cli
/mllt-cli
/mllt-cli-darwin-*
/mllt-cli-linux-*
/mllt-cli-windows-*

# Release artifacts
dist/

# Test output: tests resolve resources relative to the package directory
internal/*/resources/
